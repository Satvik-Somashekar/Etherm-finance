<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.openfinance</groupId>
    <artifactId>open-finance-aggregator</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Open Finance Aggregator</name>
    <description>Account Aggregator-inspired financial data platform</description>

    <modules>
        <module>fi-core</module>
        <module>security</module>
        <module>data-generator</module>
        <module>ingestion</module>
        <module>normalization</module>
        <module>retrieval</module>
        <module>rag-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Not managed by Spring Boot; pinned so requirePluginVersions holds for the site lifecycle too. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Fails the build on an unpinned plugin, a duplicated dependency or a library with a known critical flaw. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>supply-chain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requirePluginVersions>
                                    <message>Pin every plugin version so a build cannot change underneath us.</message>
                                </requirePluginVersions>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- Log4Shell and its follow-ups -->
                                        <exclude>org.apache.logging.log4j:log4j-core:[,2.17.1)</exclude>
                                        <!-- Deserialisation gadget chains -->
                                        <exclude>commons-collections:commons-collections:[,3.2.2)</exclude>
                                        <!-- Text4Shell -->
                                        <exclude>org.apache.commons:commons-text:[,1.10.0)</exclude>
                                        <!-- Unmaintained, with remote code execution flaws -->
                                        <exclude>log4j:log4j</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -Psbom package writes a CycloneDX bill of materials (target/classes/META-INF/sbom/application.cdx.json):
             one per module, and the parent's covers all of them. -->
        <profile>
            <id>sbom</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
